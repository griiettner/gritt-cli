{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parked backlog",
  "description": "Parking lot for deliberately deferred work. See the tkt-management skill for handling rules.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "parked_reason", "revisit_when", "references"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BKL-[0-9]{3,4}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "parked_reason": {
            "type": "string",
            "minLength": 1
          },
          "revisit_when": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
